diff --git a/Duplicati/GUI/Duplicati.GUI.TrayIcon/Probe6867.cs b/Duplicati/GUI/Duplicati.GUI.TrayIcon/Probe6867.cs
new file mode 100644
index 0000000000..840dc6f5eb
--- /dev/null
+++ b/Duplicati/GUI/Duplicati.GUI.TrayIcon/Probe6867.cs
@@ -0,0 +1,21 @@
+// Temporary probe for issue 6867, not to be committed
+using System;
+using System.IO;
+
+namespace Duplicati.GUI.TrayIcon
+{
+    internal static class Probe6867
+    {
+        private static readonly object Lock = new object();
+
+        public static void Write(string format, params object[] args)
+        {
+            var path = Environment.GetEnvironmentVariable("PROBE6867_FILE");
+            if (string.IsNullOrWhiteSpace(path))
+                return;
+            var line = $"{DateTime.Now:yyyy-MM-dd HH:mm:ss.fff} [T{Environment.CurrentManagedThreadId}] {string.Format(format, args)}{Environment.NewLine}";
+            lock (Lock)
+                File.AppendAllText(path, line);
+        }
+    }
+}
